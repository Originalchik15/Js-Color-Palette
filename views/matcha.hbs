<div class="container text-center text-white">
  <h1 class="mt-5">Midnight Matcha</h1>
  <a href="/" class="btn btn-light mt-3">Назад</a>
</div>

<div class="transparent-outline">
  <div>
    Приятный градиент из оттенков зелёного. Страница имеет слайдер который можно перемещать.<br>
    Так же под слайдером распологаются симметрично расставленные кнопочки которые пересылают на другую страницу
  </div>
</div>

<div class="slidecontainer">
  <input type="range" min="1" max="100" value="50" class="slider" id="myRange">
</div>

<script>
  const slider = document.getElementById("myRange");

  function updateSliderColor() {
    const value = slider.value;

    const red = Math.min(255, 510 - value * 5.1);  
    const green = Math.min(255, value * 5.1);   
    const blue = 100;                               

    slider.style.setProperty("--thumb-color", `rgb(${red}, ${green}, ${blue})`);


    slider.style.background = `linear-gradient(to right, rgb(${red}, ${green}, ${blue}) ${value}%, #d3d3d3 ${value}%)`;
  }

  updateSliderColor();
  slider.addEventListener("input", updateSliderColor);
</script>
